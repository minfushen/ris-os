      "labelAt": [
        960,
        428
      ]
    },
    {
      "id": "flywheel-back",
      "from": "flywheel",
      "to": "warehouse",
      "label": "样本与规则回流",
      "classification": "监控驱动迭代",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "bottom",
      "via": [
        [
          960,
          545
        ],
        [
          315,
          545
        ]
      ],
      "labelAt": [
        630,
        533
      ]
    }
  ],
